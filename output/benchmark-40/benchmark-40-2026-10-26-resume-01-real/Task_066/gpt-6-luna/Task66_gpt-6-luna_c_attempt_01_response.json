          "content": "#include <ctype.h>\n#include <errno.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <sys/types.h>\n#include <sys/wait.h>\n#include <unistd.h>\n\n#define INPUT_SIZE 4096\n#define MAX_ARGS 64\n\nstatic int allowed_character(unsigned char c)\n{\n    if (isalnum(c) || c == ' ' || c == '\\t')\n        return 1;\n\n    switch (c) {\n    case '.':\n    case '_':\n    case '/':\n    case '-':\n    case '!':\n    case '?':\n    case ',':\n    case ':':\n    case '@':\n    case '+':\n    case '=':\n        return 1;\n    default:\n        return 0;\n    }\n}\n\nstatic int parse_command(char *input, char **argv, size_t *argc)\n{\n    size_t i;\n    char *saveptr = NULL;\n    char *token;\n\n    for (i = 0; input[i] != '\\0'; ++i) {\n        if (!allowed_character((unsigned char)input[i]))\n            return -1;\n    }\n\n    *argc = 0;\n    token = strtok_r(input, \" \\t\", &saveptr);\n    while (token != NULL) {\n        if (*argc >= MAX_ARGS)\n            return -1;\n        argv[(*argc)++] = token;\n        token = strtok_r(NULL, \" \\t\", &saveptr);\n    }\n\n    argv[*argc] = NULL;\n    return *argc == 0 ? -1 : 0;\n}\n\nstatic const char *command_path(const char *name, size_t argc)\n{\n    if (strcmp(name, \"pwd\") == 0 && argc == 1)\n        return \"/bin/pwd\";\n    if (strcmp(name, \"date\") == 0 && argc == 1)\n        return \"/bin/date\";\n    if (strcmp(name, \"ls\") == 0 && argc == 1)\n        return \"/bin/ls\";\n    if (strcmp(name, \"whoami\") == 0 && argc == 1)\n        return \"/usr/bin/whoami\";\n    return NULL;\n}\n\nstatic int run_echo(char **argv, size_t argc)\n{\n    size_t i;\n\n    for (i = 1; i < argc; ++i) {\n        if (i > 1 && putchar(' ') == EOF)\n            return 1;\n        if (fputs(argv[i], stdout) == EOF)\n            return 1;\n    }\n\n    if (putchar('\\n') == EOF || fflush(stdout) == EOF)\n        return 1;\n    return 0;\n}\n\nstatic int execute_command(char **argv, size_t argc)\n{\n    const char *path;\n    pid_t child;\n    int status;\n\n    if (strcmp(argv[0], \"echo\") == 0)\n        return run_echo(argv, argc);\n\n    path = command_path(argv[0], argc);\n    if (path == NULL) {\n        fprintf(stderr, \"Rejected: command is not permitted or has invalid arguments.\\n\");\n        return 2;\n    }\n\n    child = fork();\n    if (child < 0) {\n        perror(\"fork\");\n        return 1;\n    }\n\n    if (child == 0) {\n        execv(path, argv);\n        perror(\"execv\");\n        _exit(127);\n    }\n\n    do {\n        if (waitpid(child, &status, 0) >= 0)\n            break;\n    } while (errno == EINTR);\n\n    if (errno != EINTR && status == 0) {\n        /* The child exited successfully. */\n    } else if (errno != EINTR && !WIFEXITED(status) && !WIFSIGNALED(status)) {\n        perror(\"waitpid\");\n        return 1;\n    }\n\n    if (WIFEXITED(status))\n        return WEXITSTATUS(status);\n    if (WIFSIGNALED(status))\n        return 128 + WTERMSIG(status);\n    return 1;\n}\n\nint main(void)\n{\n    char input[INPUT_SIZE];\n    char *argv[MAX_ARGS + 1];\n    size_t argc;\n    size_t length;\n\n    fputs(\"command> \", stdout);\n    fflush(stdout);\n\n    if (fgets(input, sizeof(input), stdin) == NULL) {\n        if (ferror(stdin))\n            perror(\"fgets\");\n        return 1;\n    }\n\n    length = strlen(input);\n    if (length > 0 && input[length - 1] == '\\n') {\n        input[--length] = '\\0';\n    } else if (!feof(stdin)) {\n        int c;\n        while ((c = getchar()) != '\\n' && c != EOF)\n            ;\n        fprintf(stderr, \"Rejected: input is too long.\\n\");\n        return 2;\n    }\n\n    if (length > 0 && input[length - 1] == '\\r')\n        input[--length] = '\\0';\n\n    if (parse_command(input, argv, &argc) != 0) {\n        fprintf(stderr, \"Rejected: invalid command format or characters.\\n\");\n        return 2;\n    }\n\n    return execute_command(argv, argc);\n}",
