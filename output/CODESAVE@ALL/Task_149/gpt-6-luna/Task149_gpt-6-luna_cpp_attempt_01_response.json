          "content": "#include <iostream>\n#include <optional>\n#include <string>\n#include <utility>\n\ntemplate <typename T>\nclass Queue {\nprivate:\n    struct Node {\n        T value;\n        Node* next;\n\n        explicit Node(T item) : value(std::move(item)), next(nullptr) {}\n    };\n\n    Node* head_ = nullptr;\n    Node* tail_ = nullptr;\n    std::size_t size_ = 0;\n\npublic:\n    Queue() = default;\n\n    Queue(const Queue&) = delete;\n    Queue& operator=(const Queue&) = delete;\n\n    ~Queue() {\n        while (head_ != nullptr) {\n            Node* node = head_;\n            head_ = head_->next;\n            delete node;\n        }\n    }\n\n    void enqueue(T value) {\n        Node* node = new Node(std::move(value));\n\n        if (tail_ != nullptr) {\n            tail_->next = node;\n        } else {\n            head_ = node;\n        }\n\n        tail_ = node;\n        ++size_;\n    }\n\n    std::optional<T> dequeue() {\n        if (head_ == nullptr) {\n            return std::nullopt;\n        }\n\n        Node* node = head_;\n        std::optional<T> value(std::move(node->value));\n        head_ = head_->next;\n\n        if (head_ == nullptr) {\n            tail_ = nullptr;\n        }\n\n        delete node;\n        --size_;\n        return value;\n    }\n\n    std::optional<T> peek() const {\n        if (head_ == nullptr) {\n            return std::nullopt;\n        }\n\n        return head_->value;\n    }\n\n    bool empty() const {\n        return head_ == nullptr;\n    }\n\n    std::size_t size() const {\n        return size_;\n    }\n};\n\nint main() {\n    Queue<int> queue;\n    std::string operation;\n\n    while (std::cin >> operation) {\n        if (operation == \"ENQUEUE\" || operation == \"enqueue\") {\n            int value;\n            if (std::cin >> value) {\n                queue.enqueue(value);\n            }\n        } else if (operation == \"DEQUEUE\" || operation == \"dequeue\") {\n            const auto value = queue.dequeue();\n            if (value) {\n                std::cout << *value << '\\n';\n            } else {\n                std::cout << \"EMPTY\\n\";\n            }\n        } else if (operation == \"PEEK\" || operation == \"peek\") {\n            const auto value = queue.peek();\n            if (value) {\n                std::cout << *value << '\\n';\n            } else {\n                std::cout << \"EMPTY\\n\";\n            }\n        }\n    }\n\n    return 0;\n}",
