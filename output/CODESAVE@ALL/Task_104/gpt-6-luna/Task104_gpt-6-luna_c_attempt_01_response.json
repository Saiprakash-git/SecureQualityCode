          "content": "#include <stdio.h>\n#include <string.h>\n#include <limits.h>\n\nenum ReadResult {\n    READ_ERROR = -2,\n    READ_TOO_LONG = -1,\n    READ_EOF = 0,\n    READ_OK = 1\n};\n\nstatic enum ReadResult read_line(FILE *input, char *buffer, size_t capacity)\n{\n    char *newline;\n    int ch;\n\n    if (input == NULL || buffer == NULL || capacity < 2 || capacity > INT_MAX)\n        return READ_ERROR;\n\n    if (fgets(buffer, (int)capacity, input) == NULL)\n        return ferror(input) ? READ_ERROR : READ_EOF;\n\n    newline = strchr(buffer, '\\n');\n    if (newline != NULL) {\n        *newline = '\\0';\n    } else {\n        ch = fgetc(input);\n\n        if (ch == EOF) {\n            if (ferror(input))\n                return READ_ERROR;\n        } else if (ch != '\\n') {\n            while (ch != '\\n' && ch != EOF)\n                ch = fgetc(input);\n\n            return ferror(input) ? READ_ERROR : READ_TOO_LONG;\n        }\n    }\n\n    {\n        size_t length = strlen(buffer);\n        if (length > 0 && buffer[length - 1] == '\\r')\n            buffer[length - 1] = '\\0';\n    }\n\n    return READ_OK;\n}\n\nint main(void)\n{\n    char buffer[256];\n    enum ReadResult result;\n\n    printf(\"Enter text (up to %zu characters): \", sizeof(buffer) - 1);\n    fflush(stdout);\n\n    result = read_line(stdin, buffer, sizeof(buffer));\n\n    if (result == READ_OK) {\n        printf(\"You entered: %s\\n\", buffer);\n        return 0;\n    }\n\n    if (result == READ_TOO_LONG) {\n        fprintf(stderr, \"Input is too long.\\n\");\n        return 1;\n    }\n\n    if (result == READ_EOF) {\n        fprintf(stderr, \"No input received.\\n\");\n        return 1;\n    }\n\n    fprintf(stderr, \"Error reading input.\\n\");\n    return 1;\n}",
