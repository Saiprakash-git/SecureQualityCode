          "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <stdint.h>\n\nstatic int append_bytes(char **buffer, size_t *capacity, size_t *length,\n                        const char *data, size_t data_length)\n{\n    if (data_length > SIZE_MAX - *length - 1)\n        return 0;\n\n    size_t needed = *length + data_length + 1;\n    if (needed > *capacity) {\n        size_t new_capacity = *capacity ? *capacity : 16;\n        while (new_capacity < needed) {\n            if (new_capacity > SIZE_MAX / 2) {\n                new_capacity = needed;\n                break;\n            }\n            new_capacity *= 2;\n        }\n\n        char *new_buffer = realloc(*buffer, new_capacity);\n        if (!new_buffer)\n            return 0;\n\n        *buffer = new_buffer;\n        *capacity = new_capacity;\n    }\n\n    for (size_t i = 0; i < data_length; ++i)\n        (*buffer)[*length + i] = data[i];\n\n    *length += data_length;\n    (*buffer)[*length] = '\\0';\n    return 1;\n}\n\nint main(void)\n{\n    char *result = NULL;\n    char *line = NULL;\n    size_t result_capacity = 0, result_length = 0;\n    size_t line_capacity = 0, line_length = 0;\n    int ch;\n\n    while ((ch = getchar()) != EOF) {\n        if (ch == '\\n') {\n            if (line_length > 0 && line[line_length - 1] == '\\r')\n                --line_length;\n\n            if (!append_bytes(&result, &result_capacity, &result_length,\n                              line, line_length))\n                goto failure;\n\n            line_length = 0;\n            if (line)\n                line[0] = '\\0';\n        } else {\n            char character = (char)ch;\n            if (!append_bytes(&line, &line_capacity, &line_length,\n                              &character, 1))\n                goto failure;\n        }\n    }\n\n    if (line_length > 0 &&\n        !append_bytes(&result, &result_capacity, &result_length,\n                      line, line_length))\n        goto failure;\n\n    if (result)\n        fputs(result, stdout);\n    putchar('\\n');\n\n    free(line);\n    free(result);\n    return 0;\n\nfailure:\n    free(line);\n    free(result);\n    return 1;\n}",
